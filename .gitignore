# ==========================================================
# JIG Studio - Python .gitignore
# ==========================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
share/python-wheels/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# uv
.uv/
uv.lock

# Pip
pip-log.txt
pip-delete-this-directory.txt

# Installer logs
pip-wheel-metadata/

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/
coverage.xml
*.cover
*.py,cover

# Type checker
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Ruff
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.iml

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Logs
logs/
*.log

# SQLite
*.sqlite
*.sqlite3
database/*.db

# Environment variables
.env
.env.*
!.env.example

# Secrets
secrets.json
credentials.json
service-account.json

# Temporary files
tmp/
temp/
*.tmp

# Generated videos
output/
renders/
exports/

# Downloaded media
downloads/
cache/

# FFmpeg temp
ffmpeg_temp/

# MoviePy temp
media_temp/

# Assets generated by AI
generated/
thumbnails/

# Docker
docker-compose.override.yml

# Git
*.orig
*.rej

# OS generated files
ehthumbs.db

# Local documentation build
docs/_build/

# MkDocs
site/

# Sphinx
_build/

# Backup files
*.bak
*.old

# Local runtime data
runtime/

# Scheduler state
scheduler_state.json
